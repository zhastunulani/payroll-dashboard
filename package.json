{
  "name": "payroll-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local --host 0.0.0.0 --port 3100",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "build:worker": "nuxt build --preset=cloudflare_module",
    "preview:worker": "npm run build:worker && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy --secrets-file .env.local",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "sync:worker-env": "node scripts/sync-cloudflare-dev-env.mjs",
    "postinstall": "nuxt prepare",
    "hash-password": "node scripts/hash-password.mjs",
    "test:unit": "node --experimental-transform-types --test tests/calculations.test.ts tests/postgres-database.test.ts tests/money.test.ts tests/months.test.ts tests/payroll-import.test.ts tests/bulk-employees.test.ts tests/expenses.test.ts tests/keep-alive.test.ts tests/employee-notes.test.ts tests/workspaces.test.ts",
    "typecheck": "nuxt typecheck",
    "test": "npm run test:unit && npm run typecheck && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "h3": "1.15.11",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "^4.5.1",
    "read-excel-file": "^9.3.4",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "22.19.19",
    "eslint": "^10.8.1",
    "typescript": "5.9.3",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
