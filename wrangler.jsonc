{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "payroll-dashboard",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "APP_PASSWORD_HASH",
      "SESSION_SECRET"
    ]
  }
}
